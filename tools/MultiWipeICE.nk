set cut_paste_input [stack 0]
version 13.2 v1
push $cut_paste_input
Group {
 name MultiWipeICE
 knobChanged "tn = nuke.thisNode()\nk = nuke.thisKnob()\n\n\nif k.name() in \[\"wipe_start\", \"wipe_duration\", \"inputChange\", \"wipe_hold\", \"breakdown_style\"]:\n    inputs = tn.inputs()    \n    start = tn\['wipe_start'].value()\n    breakdown_last_frame = tn\['breakdown_last_frame'].value()\n    duration = tn.knob('wipe_duration').value()\n    \n    fifr = 0\n    lilf = 0\n    if inputs > 0:\n        fifr = tn\['first_input_first_frame'].value()\n        lilf = tn\['last_input_last_frame'].value()\n\n    hold = tn.knob('wipe_hold').value()\n    end_frame = int( ((inputs-1)*duration) + ((inputs-2)*hold) + start)\n    if inputs == 0:\n        end_frame = int(start)\n    framerange_text = f'<font size=\"+3\"><font style=\"color: \\#EDBB28;\"> \{int(fifr)\}</font> | <font style=\"color: \\#31DE48;\">  \{int(start)\} - \{int(end_frame)\} </font> | <font style=\"color: \\#EDBB28;\"> \{int(breakdown_last_frame)\}'\n    # Dummy variables for the top row numbers\n\n    num1 = int(fifr)\n    num2 = int(start)\n    num3 = int(end_frame)\n    num4 = int(breakdown_last_frame)\n    \n    html_table = f\"\"\"\n    <table style=\"border-collapse: collapse; font-family: sans-serif; text-align: center;\">\n      <tr style=\"font-weight: bold; font-size: 18px;\">\n        <td style=\"color: #FFA500; padding: 3px 10px; border: 1px solid #ccc;\">\{num1\}</td>\n        <td style=\"color: #008000; padding: 3px 10px; border: 1px solid #ccc;\">\{num2\}</td>\n        <td style=\"color: #008000; padding: 3px 10px; border: 1px solid #ccc;\">\{num3\}</td>\n        <td style=\"color: #FFA500; padding: 3px 10px; border: 1px solid #ccc;\">\{num4\}</td>\n      </tr>\n      <tr style=\"font-size: 12px;\">\n        <td style=\"color: #FFA500; padding: 3px 10px; border: 1px solid #ccc;\">Start</td>\n        <td style=\"color: #008000; padding: 3px 10px; border: 1px solid #ccc;\">Wipes start</td>\n        <td style=\"color: #008000; padding: 3px 10px; border: 1px solid #ccc;\">Wipes end</td>\n        <td style=\"color: #FFA500; padding: 3px 10px; border: 1px solid #ccc;\">End</td>\n      </tr>\n    </table>\n    \"\"\"\n    \n    tn\['framerange_text'].setValue(html_table)\n        #tn\['label'].setValue(framerange_text)"
 selected true
 xpos -339
 ypos 528
 addUserKnob {20 multiwipe l "Multi Wipe"}
 addUserKnob {26 text_2 l "" +STARTLINE T "<font size=\"+5\">🧊 Multi Wipe ICE🧊"}
 addUserKnob {26 about l "" +STARTLINE T "<font style=\"color: #666666;\">v1.4 | <a href=\"https://www.linkedin.com/in/petejans/\" style=\"color: #6786b8;\">Peter Jansen</a>"}
 addUserKnob {26 ""}
 addUserKnob {26 framerange_text l "" +STARTLINE T "\n<table style=\"border-collapse: collapse; font-family: sans-serif; text-align: center;\">\n  <tr style=\"font-weight: bold; font-size: 18px;\">\n    <td style=\"color: #FFA500; padding: 3px 10px; border: 1px solid #ccc;\">0</td>\n    <td style=\"color: #008000; padding: 3px 10px; border: 1px solid #ccc;\">1001</td>\n    <td style=\"color: #008000; padding: 3px 10px; border: 1px solid #ccc;\">1001</td>\n    <td style=\"color: #FFA500; padding: 3px 10px; border: 1px solid #ccc;\">0</td>\n  </tr>\n  <tr style=\"font-size: 12px;\">\n    <td style=\"color: #FFA500; padding: 3px 10px; border: 1px solid #ccc;\">Start</td>\n    <td style=\"color: #008000; padding: 3px 10px; border: 1px solid #ccc;\">Wipes start</td>\n    <td style=\"color: #008000; padding: 3px 10px; border: 1px solid #ccc;\">Wipes end</td>\n    <td style=\"color: #FFA500; padding: 3px 10px; border: 1px solid #ccc;\">End</td>\n  </tr>\n</table>\n"}
 addUserKnob {26 ""}
 addUserKnob {4 breakdown_style l "breakdown style" M {"wipe while playing" "hold frame"}}
 addUserKnob {4 wipe_style l "wipe style" +INVISIBLE M {"simple line" "Yusuke's dope glitch"}}
 addUserKnob {26 text_4 l "" +STARTLINE +INVISIBLE T "<font style=\"color: #666666;\">Creative wipe will always be output in the Breakdown_Alt layer"}
 addUserKnob {26 text l "<b> Wipe"}
 addUserKnob {3 wipe_start l "start frame"}
 wipe_start 1001
 addUserKnob {3 breakdown_duration +INVISIBLE}
 breakdown_duration {{"this.inputs == 0? wipe_start: ( ((this.inputs-1) * wipe_duration) + (this.inputs-2) * wipe_hold)"}}
 addUserKnob {3 wipe_end l "end frame (hidden)" +INVISIBLE}
 wipe_end {{"breakdown_duration + wipe_start"}}
 addUserKnob {3 first_input_first_frame l "first input first frame" +INVISIBLE}
 first_input_first_frame {{this.input0.first_frame}}
 addUserKnob {3 last_input_last_frame l "last input last frame" -STARTLINE +INVISIBLE}
 last_input_last_frame {{"\[node this.input\[expr \[value this.inputs]-1]].last_frame"}}
 addUserKnob {3 breakdown_last_frame l "breakdown last frame" +INVISIBLE}
 breakdown_last_frame {{"breakdown_style? last_input_last_frame + breakdown_duration :last_input_last_frame "}}
 addUserKnob {3 wipe_duration l duration +INVISIBLE}
 wipe_duration 7
 addUserKnob {26 text_3 l duration T "<font style=\"color: #666666;\">locked to 7 frames"}
 addUserKnob {3 wipe_hold l "frames between wipes"}
 wipe_hold 12
 addUserKnob {7 wipe_angle l angle R 0 360}
 addUserKnob {4 wipe_animation l animation M {linear smooth decelerating accelerating}}
 addUserKnob {26 text_1 l "<b> Line"}
 addUserKnob {7 line_width l width R 0 10}
 line_width 2
 addUserKnob {7 line_softness l softness}
 addUserKnob {41 white l colour T Grade1.white}
 addUserKnob {6 color_rgba_panelDropped l "panel dropped state" +HIDDEN +STARTLINE}
}
