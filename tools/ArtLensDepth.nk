  ArtLensDepthKernel_RefineSteps {{"\[python nuke.thisParent().knob('refine_steps_farm').value()\\ if\\ nuke.executing()\\ else\\ nuke.thisParent().knob('refine_steps_gui').value()]"}}
  ArtLensDepthKernel_SphericalAberration {{parent.spherical_aberration}}
