Group {
 name ArtLensDepth
 knobChanged "n = nuke.thisNode()\nk = nuke.thisKnob()\n\nif k.name() == \"focal_point\":\n    sx = k.value(0)\n    sy = k.value(1)\n    parent = nuke.thisNode().input(0)\n    depth_layer = n.knob('in').value()\n    depth_channels = nuke.Layer(depth_layer).channels()\n    depth = parent.sample(depth_channels\[0], sx, sy)\n    \n    if n.knob('bg_depth_style').value() == 'inverted (1/z)':\n        depth = 1.0 / float(depth)\n\n    n.knob('focalDistance').setValue(depth)"
 selected true
 addUserKnob {20 User l "Art Lens Depth"}
 addUserKnob {26 title l "" +STARTLINE T "<font size=\"+5\"> Art Lens Depth"}
 addUserKnob {26 about l "" t "0.1 - initial build, shell from art lens 2d\n0.2 - tidy up\n" +STARTLINE T "<font style=\"color: #666666;\">v0.2 | <a href=\"https://www.linkedin.com/in/petejans/\" style=\"color: #6786b8;\">Peter Jansen</a>"}
 addUserKnob {26 ""}
 addUserKnob {4 output_mode l output M {composited BG FG ""}}
 addUserKnob {26 depth_text l <b>Depth}
 addUserKnob {4 units l "world units" M {mm cm dm m km inch feet yards ""}}
 addUserKnob {41 in l "BG depth" T Shuffle2.in}
 addUserKnob {4 bg_depth_style l math -STARTLINE M {"depth (real)" "inverted (1/z)"}}
 addUserKnob {41 in_1 l "FG depth" T Shuffle4.in}
 addUserKnob {4 fg_depth_style l math -STARTLINE M {"depth (real)" "inverted (1/z)" ""}}
 addUserKnob {26 text_4 l "<b> Set Focus"}
 addUserKnob {12 focal_point l "focal point"}
 addUserKnob {7 focalDistance l "focal distance" R 0 200}
 focalDistance 10
 addUserKnob {26 lens_parm_text l "<b> Lens parameters"}
 addUserKnob {7 focalLength l "focal length" R 0 100}
 focalLength 50
 addUserKnob {7 fStop R 0.1 32}
 fStop 2.8
 addUserKnob {7 filmBack l "filmback width" R 0 100}
 filmBack 24
 addUserKnob {26 cheat_tweaks_text l <b>cheat/tweaks}
 addUserKnob {7 BG_mult l "BG mult" R 0 10}
 BG_mult 1
 addUserKnob {7 FG_mult l "FG mult" R 0 10}
 FG_mult 1
 addUserKnob {26 divider02 l "" +STARTLINE}
 addUserKnob {26 text_2 l "<b> Artsy"}
 addUserKnob {7 spherical_aberration l "spherical aberration" t "Produces rings on the outer edge of bokeh, or \"creamier\" bokeh on the other side of focal plane. Flips based on which side of the focal plane we're on." R -0.5 0.5}
 addUserKnob {7 astigmatism l asitgmatism t "Swirls, or stretches the bokehs towards the edge of frame (tangential or sagittal). Flips based on which side of the focal plane we're on." R -2 2}
 addUserKnob {7 cateye l "cateye occlusion" t "Emulates occlusion on the bokehs caused by the aperture. Flips based on which side of the focal plane we're on." R -1 1}
 addUserKnob {20 CA_group l "chromatic aberration" n 1}
 CA_group 0
 addUserKnob {26 text l <b>lateral}
 addUserKnob {7 lateral_CA l chromatic t "Full spectrum chromatic aberration that increases based on distance from center." R -10 10}
 addUserKnob {7 lateral_aCA l achromatic t "Emulates corrected chromatic aberration. Creates magenta/green aberration instead of yellow/blue." R -10 10}
 addUserKnob {26 text_1 l <b>longitudinal}
 addUserKnob {7 long_CA l chromatic t "Full spectrum colour splitting that is EVEN throughout the frame. Flips based on which side of the focal plane we're on." R -10 10}
 addUserKnob {7 long_aCA l achromatic t "Green/magenta aberration that is EVEN across the frame. Flips based on which side of the focal plane we're on." R -10 10}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 barndorrs_grp l "barn doors" n 1}
 barndorrs_grp 0
 addUserKnob {7 barn_top l top R 0 0.5}
 addUserKnob {7 barn_bottom l bottom R 0 0.5}
 addUserKnob {7 barn_left l left R 0 0.5}
 addUserKnob {7 barn_right l right R 0 0.5}
 addUserKnob {20 endGroup_1 l endGroup n -1}
 addUserKnob {7 ana_squeeze l "anamorphic squeeze" t "Anamorphic squeeze" R 0.1 2}
 ana_squeeze 1
 addUserKnob {7 vignette_compensation l "vignette compensation" t "Restores energy lost from optical vignetting (cateye and barndoors)"}
 vignette_compensation 1
 addUserKnob {26 text_5 l <b>Dirt}
 addUserKnob {26 text_6 l "" +STARTLINE T "<font style=\"color: #666666;\"> Uses dirt input alpha to emulate dust/dirt/hair on lens. Imprints on BG/FG bokehs."}
 addUserKnob {7 dirt_CoC l "dirt defocus" t "How defocused the dirt image is \"on the glass\". Lower values will make the dirt slide around in the bokehs as they move. " R 200 600}
 dirt_CoC 250
 addUserKnob {7 dirt_scale l "scale (fix cropping)" t "Use this to fix dirt textures cropping" R 1 2}
 dirt_scale 1.25
 addUserKnob {7 dirt_exposure_comp l "exposure compensation" t "Restores energy lost from the dirt occlusion"}
 dirt_exposure_comp 1
 addUserKnob {26 text_3 l <b>Quality}
 addUserKnob {3 samples_gui l "<b>Samples </b> | gui" t "Number of samples used in the gui"}
 samples_gui 12
 addUserKnob {3 samples_farm l farm t "Number of samples that render on the farm" -STARTLINE}
 samples_farm 64
 addUserKnob {6 jitter_samples l "jitter samples" t "Randomly offsets the samples for a more natural look, instead of a digital, replicated look." -STARTLINE}
 jitter_samples true
 addUserKnob {3 march_steps_gui l "<b>March Steps</b> | gui"}
 march_steps_gui 32
 addUserKnob {3 march_steps_farm l farm -STARTLINE}
 march_steps_farm 32
 addUserKnob {3 refine_steps_gui l "<b>Refine Steps</b> | gui"}
 refine_steps_gui 3
 addUserKnob {3 refine_steps_farm l farm -STARTLINE}
 refine_steps_farm 3
 addUserKnob {7 preblur_highlights l "preblur highlights" t "Slightly blurs the incoming images (adaptive to defocus size). Helps greatly with sampling of small, bright pixels."}
 preblur_highlights 0.5
 addUserKnob {26 ""}
}
