 BlinkScript {
  recompileCount 1
  ProgramGroup 1
  KernelDescription "2 \"ArtLensDepthCoCKernel\" iterate pixelWise 9bbb19bb080eb529eb53d6f7b8266451118b8ace2de627b592f12de480468e6e 2 \"depth\" Read Point \"dst\" Write Point 9 \"FocalLength\" Float 1 AABIQg== \"FStop\" Float 1 MzMzQA== \"FocusDistance\" Float 1 AACgQA== \"SensorWidth\" Float 1 AAAQQg== \"WorldScale\" Float 1 AAB6RA== \"Mult\" Float 1 AACAPw== \"NearCoCLimit\" Float 1 AABwQg== \"FormatSize\" Int 2 gAcAADgEAAA= \"PixelAspect\" Float 1 AACAPw== 9 \"focalLength\" 1 1 \"fStop\" 1 1 \"focusDistance\" 1 1 \"sensorWidth\" 1 1 \"worldScale\" 1 1 \"mult\" 1 1 \"nearLimit\" 1 1 \"formatSize\" 2 1 \"pixelAspect\" 1 1 4 \"cK\" Float 1 1 AAAAAA== \"cKF\" Float 1 1 AAAAAA== \"cNear\" Float 1 1 AAAAAA== \"cFar\" Float 1 1 AAAAAA=="
  kernelSource "// ---------------------------------------------------------------------------\n//  ArtLensDepthCoC.blink                                   Nuke BlinkScript\n// ---------------------------------------------------------------------------\n//  Depth in, signed circle of confusion out. The first of three small kernels\n//  that sit in front of ArtLensDepth from revision 11 on, one chain per layer:\n//\n//      depth -> ArtLensDepthCoC -> ArtLensDepthTiles -> ArtLensDepthBounds\n//                      |                                        |\n//                      +---- bgCoC / fgCoC          bgBounds / fgBounds\n//\n//  WHY IT EXISTS. Up to revision 10 the main kernel turned depth into CoC on\n//  every read of its march -- a divide, a compare and a clamp, thousands of\n//  times per pixel, always producing the same answer for the same texel. Here\n//  it is done once per pixel instead, and the march reads the result.\n//\n//  IT MUST AGREE WITH THE MAIN KERNEL TO THE BIT. init() below is the camera\n//  block of ArtLensDepth's init(), statement for statement, so the same knob\n//  values give the same floats and the image comes out identical to\n//  revision 10. If the camera maths ever changes there, change it here too.\n//  Link every knob to its namesake on the main node:\n//\n//      FocalLength, FStop, FocusDistance, SensorWidth, WorldScale,\n//      FormatSize, PixelAspect            the same on both chains\n//      Mult                               BGMult on one chain, FGMult on the other\n//      NearCoCLimit                       BGNearCoCLimit / FGNearCoCLimit\n//\n//  Link Format Size as you do on the main node. Left at 0 it falls back to the\n//  width of THIS node's input, where the main kernel falls back to the width\n//  of its bg -- the same number only when the depth is registered to bg.\n//\n//  The main kernel still clamps what it reads into its own \[near, far]. With\n//  the knobs linked that clamp changes nothing; it is there so that a CoC\n//  image from anywhere else cannot break the march's guarantee that every ray\n//  terminates.\n//\n//  ---- INPUT / OUTPUT -------------------------------------------------------\n//    depth     straight distance from camera in world units, in RED. Not 1/Z.\n//    output    signed CoC radius in pixels in RGB, 1 in alpha. Negative in\n//              front of focus, positive behind, clamped to\n//              \[-NearCoCLimit, CoC at infinity]. Depth of 0 or less reads as\n//              the near limit.\n//\n//  Set the image to 4 channels (rgba).\n// ---------------------------------------------------------------------------\n\nkernel ArtLensDepthCoCKernel : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> depth;\n  Image<eWrite>                            dst;\n\n  param:\n    float focalLength;      // mm, as engraved\n    float fStop;            // f-number\n    float focusDistance;    // world units\n    float sensorWidth;      // mm, physical film back width\n    float worldScale;       // mm per world unit. 1000 = scene in metres\n    float mult;             // BGMult or FGMult, whichever layer this chain is\n    float nearLimit;        // BGNearCoCLimit or FGNearCoCLimit, likewise\n    int2  formatSize;       // format w/h in pixels -- NOT the bbox. 0 = use bbox\n    float pixelAspect;      // pixel width / pixel height\n\n  local:\n    float cK;               // CoC at infinity\n    float cKF;              // cK * focusDistance, so that c = cK - cKF / Z\n    float cNear;\n    float cFar;\n\n  void define()\n  \{\n    defineParam(focalLength,       \"FocalLength\",                50.0f);\n    defineParam(fStop,             \"FStop\",                      2.8f);\n    defineParam(focusDistance,     \"FocusDistance\",              5.0f);\n    defineParam(sensorWidth,       \"SensorWidth\",                36.0f);\n    defineParam(worldScale,        \"WorldScale\",                 1000.0f);\n    defineParam(mult,              \"Mult\",                       1.0f);\n    defineParam(nearLimit,         \"NearCoCLimit\",               60.0f);\n    defineParam(formatSize,        \"FormatSize\",                 int2(1920, 1080));\n    defineParam(pixelAspect,       \"PixelAspect\",                1.0f);\n  \}\n\n  void init()\n  \{\n    // ---- keep in step with the camera block of ArtLensDepth's init() ------\n    float par  = max(pixelAspect, 1e-6f);\n\n    float fmtW = float(formatSize.x);\n    float fmtH = float(formatSize.y);\n    if (fmtW < 1.0f || fmtH < 1.0f)\n      fmtW = float(depth.bounds.width());\n\n    float f       = max(focalLength, 1e-3f);\n    float focusMM = max(focusDistance * worldScale, 1e-3f);\n    float apMM    = f / max(fStop, 1e-3f);\n    float pxPerMM = (fmtW * par) / max(sensorWidth, 1e-3f);\n    float cocK    = 0.5f * apMM * f / focusMM * pxPerMM;\n\n    cK    = cocK * mult;\n    cKF   = cK * focusDistance;\n    cFar  = max(cK, 0.0f);\n    cNear = -max(nearLimit, 1e-3f);\n  \}\n\n  void process()\n  \{\n    // Exactly the expression the main kernel's layerCoC() used up to\n    // revision 10, so the stored value is the one it would have computed.\n    float raw = depth().x;\n    float c   = (raw > 1e-6f) ? (cK - cKF / raw) : cNear;\n    c = clamp(c, cNear, cFar);\n    dst() = float4(c, c, c, 1.0f);\n  \}\n\};\n"
  rebuild ""
  ArtLensDepthCoCKernel_FocalLength {{parent.focalLength}}
  ArtLensDepthCoCKernel_FStop {{parent.fStop}}
  ArtLensDepthCoCKernel_FocusDistance {{parent.focalDistance}}
  ArtLensDepthCoCKernel_SensorWidth {{parent.filmBack}}
  ArtLensDepthCoCKernel_WorldScale {{parent.BlinkScript2.ArtLensDepthKernel_WorldScale}}
  ArtLensDepthCoCKernel_Mult {{parent.BG_mult}}
  ArtLensDepthCoCKernel_NearCoCLimit {{parent.max_near_size}}
  ArtLensDepthCoCKernel_FormatSize {{width} {height}}
  ArtLensDepthCoCKernel_PixelAspect {{pixel_aspect}}
  rebuild_finalise ""
  name BlinkScript1
  xpos 581
  ypos -116
 }
