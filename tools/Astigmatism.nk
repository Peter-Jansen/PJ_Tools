Group {
 name Astigmatism
 selected true
 addUserKnob {20 astigmatism l Astigmatism}
 addUserKnob {26 title l "" +STARTLINE T "<font size=\"+5\"> Astigmatism"}
 addUserKnob {26 about l "" +STARTLINE T "<font style=\"color: #666666;\">v1.0 | <a href=\"https://www.linkedin.com/in/petejans/\" style=\"color: #6786b8;\">Peter Jansen</a>"}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {41 channels T VectorBlurOverscan.channels}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {6 preview_shape l "preview shape/falloff" +STARTLINE}
 addUserKnob {26 textttt l <b>Strength}
 addUserKnob {7 strength R 0 100}
 strength 50
 addUserKnob {26 text_1 l "<b> falloff"}
 addUserKnob {7 protect_center l "protect center"}
 protect_center 0.5
 addUserKnob {7 falloff_edge l "falloff edge" R 0 2}
 falloff_edge 1
 addUserKnob {6 clamp_beyond l "clamp beyond edge" -STARTLINE}
 addUserKnob {7 falloff l "falloff gamma"}
 falloff 1
 addUserKnob {26 text l <b>Shape}
 addUserKnob {7 width R 0 2}
 width 1
 addUserKnob {7 height R 0 2}
 height 1
 addUserKnob {7 offsetx l "offset x" R -1 1}
 addUserKnob {7 offsety l "offset y" R -1 1}
 addUserKnob {41 usePAR l "respect pixel aspect" T Expression1.usePAR}
 addUserKnob {26 "" +STARTLINE}
}
