ypos 376
}
Input {
inputs 0
name Source
xpos -356
ypos 178
}
Dot {
name Dot10
xpos -322
ypos 271
}
set N9d1e5800 [stack 0]
add_layer {temp_alpha temp_alpha.alpha}
AddChannels {
