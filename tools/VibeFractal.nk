  FractalFlameOverscan_SamplesPerPixel {{"\[python -execlocal farm\\ =\\ nuke.thisParent().knob('samples_farm').value()\\ngui\\ =\\ nuke.thisParent().knob('samples_gui').value()\\nif\\ nuke.executing():\\n\\ \\ \\ \\ ret\\ =\\ farm\\nelse:\\n\\ \\ \\ \\ if\\ nuke.thisParent().knob('preview_farm').value():\\n\\ \\ \\ \\ \\ \\ \\ \\ ret\\ =\\ farm\\n\\ \\ \\ \\ else:\\n\\ \\ \\ \\ \\ \\ \\ \\ ret\\ =\\ gui]"}}
  FractalFlameOverscan_FuseIterations 8
  FractalFlameOverscan_FlameTranslate {{parent.global_translate} {parent.global_translate} {parent.global_translate}}
  FractalFlameOverscan_FlameRotate {{parent.global_rotate} {parent.global_rotate} {parent.global_rotate}}
  FractalFlameOverscan_FlameScale {{parent.global_scale}}
