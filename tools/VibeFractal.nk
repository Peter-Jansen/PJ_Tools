  FractalFlameOverscan_LateralCA {{parent.lateral_CA}}
  FractalFlameOverscan_LateralAchromaticCA {{parent.lateral_aCA}}
  FractalFlameOverscan_LongitudinalCA {{parent.long_CA}}
  FractalFlameOverscan_LongitudinalAchromaticCA {{parent.long_aCA}}
