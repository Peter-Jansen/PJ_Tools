  FractalFlameOverscan_fstop {{parent.fstop}}
  FractalFlameOverscan_EnableDepthOfField {{parent.enable_dof}}
  FractalFlameOverscan_UnitsPerMetre 100
  FractalFlameOverscan_ApertureInput {{"\[exists parent.input1]"}}
  FractalFlameOverscan_SphericalAberration {{parent.spherical_aberration}}
  FractalFlameOverscan_Astigmatism {{parent.astigmatism}}
