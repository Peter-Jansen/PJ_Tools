Group {
 name ArtLens
 knobChanged "n = nuke.thisNode()\nk = nuke.thisKnob()\n\nif k.name() == \"enableSim\":\n    lensSimKnobs = \[n.knob('units'), n.knob('bg_depth'),n.knob('fg_depth'), n.knob('focalDistance'), n.knob('focalLength'), n.knob('fStop'), n.knob('filmBack'), n.knob('divider01'), n.knob('divider02')]\n    sizeKnobs = \[n.knob('bg_size'), n.knob('fg_size')]\n    if k.value():\n        for knob in lensSimKnobs:\n            knob.clearFlag(nuke.INVISIBLE)\n        for knob in sizeKnobs:\n            knob.setFlag(nuke.INVISIBLE)\n        \n    else:\n        for knob in lensSimKnobs:\n            knob.setFlag(nuke.INVISIBLE)\n        for knob in sizeKnobs:\n            knob.clearFlag(nuke.INVISIBLE)            \n            \n#Switch unit multiplier\nif k.name() in \['units']:\n  conv = \[10.0,1.0,0.1,0.01,0.00001,1/2.54,1/30.48,1/91.44,1.0]\n  unit = n\['units'].getValue()\n  n\['unitMult'].setValue(conv\[int(unit)])"
 selected true
 addUserKnob {20 User l "Art Lens"}
 addUserKnob {26 title l "" +STARTLINE T "<font size=\"+5\"> Art Lens"}
 addUserKnob {26 about l "" t "0.1 - initial build\n0.2 - tooltips and coc maps take alpha\n1.0 - add lens simulation\n1.1 - add dirt layer, tidy up\n1.2 - fix knob names in blinkscript\n1.3 - preblur highlights knob" +STARTLINE T "<font style=\"color: #666666;\">v1.3 | <a href=\"https://www.linkedin.com/in/petejans/\" style=\"color: #6786b8;\">Peter Jansen</a>"}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {41 useGPUIfAvailable l "Use GPU if available" T BlinkScript12.useGPUIfAvailable}
 addUserKnob {26 ""}
 addUserKnob {4 output_mode l "output mode" M {composited BG FG}}
 addUserKnob {6 enableSim l "Use lens attributes to calculate size" +STARTLINE}
 addUserKnob {26 size_text l <b>Size}
 addUserKnob {7 bg_depth l "BG depth" +INVISIBLE R 0 100}
 bg_depth 50
 addUserKnob {7 fg_depth l "FG depth" +INVISIBLE R 0 100}
 fg_depth 5
 addUserKnob {26 divider01 l "" +STARTLINE +INVISIBLE}
 addUserKnob {4 units l "world units" +INVISIBLE M {mm cm dm m km inch feet yards}}
 units dm
 addUserKnob {7 focalDistance l "focal distance" +INVISIBLE R 0 200}
 focalDistance 12
 addUserKnob {7 focalLength l "focal length" +INVISIBLE R 0 100}
 focalLength 50
 addUserKnob {7 fStop +INVISIBLE R 0.1 32}
 fStop 3
 addUserKnob {7 filmBack l "filmback width" +INVISIBLE R 0 100}
 filmBack 24
 addUserKnob {26 divider02 l "" +STARTLINE +INVISIBLE}
 addUserKnob {7 bg_size l BG t "Circle of confusion size for the BG. Positive values are behind the focal plane, negative in front. Certain optical effects will flip based on which side of the focal plane they are." R -100 100}
 bg_size 12
 addUserKnob {7 fg_size l FG t "Same as BG. Having a FG will simulate eclipsed bokeh on the BG bokehs." R -100 100}
 fg_size -24
 addUserKnob {7 ana_squeeze l squeeze t "Anamorphic squeeze" R 0.1 2}
 ana_squeeze 1
 addUserKnob {26 text_2 l "<b> Artsy"}
 addUserKnob {7 spherical_aberration l "spherical aberration" t "Produces rings on the outer edge of bokeh, or \"creamier\" bokeh on the other side of focal plane. Flips based on which side of the focal plane we're on." R -1 1}
 addUserKnob {7 astigmatism l asitgmatism t "Swirls, or stretches the bokehs towards the edge of frame (tangential or sagittal). Flips based on which side of the focal plane we're on." R -2 2}
 addUserKnob {7 cateye l "cateye occlusion" t "Emulates occlusion on the bokehs caused by the aperture. Flips based on which side of the focal plane we're on." R -1 1}
 addUserKnob {20 CA_group l "chromatic aberration" n 1}
 CA_group 0
 addUserKnob {26 text l <b>lateral}
 addUserKnob {7 lateral_CA l chromatic t "Full spectrum chromatic aberration that increases based on distance from center." R -10 10}
 addUserKnob {7 lateral_aCA l achromatic t "Emulates corrected chromatic aberration. Creates magenta/green aberration instead of yellow/blue." R -10 10}
 addUserKnob {26 text_1 l <b>longitudinal}
 addUserKnob {7 long_CA l chromatic t "Full spectrum colour splitting that is EVEN throughout the frame. Flips based on which side of the focal plane we're on." R -10 10}
 addUserKnob {7 long_aCA l achromatic t "Green/magenta aberration that is EVEN across the frame. Flips based on which side of the focal plane we're on." R -10 10}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 barndorrs_grp l "barn doors" n 1}
 barndorrs_grp 0
 addUserKnob {7 barn_top l top R 0 0.5}
 addUserKnob {7 barn_bottom l bottom R 0 0.5}
 addUserKnob {7 barn_left l left R 0 0.5}
 addUserKnob {7 barn_right l right R 0 0.5}
 addUserKnob {20 endGroup_1 l endGroup n -1}
 addUserKnob {7 vignette_compensation l "vignette compensation" t "Restores energy lost from optical vignetting (cateye and barndoors)"}
 vignette_compensation 1
 addUserKnob {26 text_5 l <b>Dirt}
 addUserKnob {26 text_6 l "" +STARTLINE T "<font style=\"color: #666666;\"> Uses dirt input alpha to emulate dust/dirt/hair on lens. Imprints on BG/FG bokehs."}
 addUserKnob {7 dirt_CoC l "dirt defocus" t "How defocused the dirt image is \"on the glass\". Lower values will make the dirt slide around in the bokehs as they move. " R 200 600}
 dirt_CoC 250
 addUserKnob {7 dirt_scale l "scale (fix cropping)" t "Use this to fix dirt textures cropping" R 1 2}
 dirt_scale 1.25
 addUserKnob {7 dirt_exposure_comp l "exposure compensation" t "Restores energy lost from the dirt occlusion"}
 dirt_exposure_comp 1
 addUserKnob {26 text_3 l <b>Samples}
 addUserKnob {3 samples_gui l gui t "Number of samples used in the gui"}
 samples_gui 24
 addUserKnob {3 samples_farm l farm t "Number of samples that render on the farm" -STARTLINE}
 samples_farm 64
 addUserKnob {6 jitter_samples l "jitter samples" t "Randomly offsets the samples for a more natural look, instead of a digital, replicated look." -STARTLINE}
 jitter_samples true
 addUserKnob {7 preblur_highlights l "preblur highlights" t "Slightly blurs the incoming images (adaptive to defocus size). Helps greatly with sampling of small, bright pixels."}
 preblur_highlights 0.5
 addUserKnob {26 ""}
 addUserKnob {7 unitMult +INVISIBLE}
 unitMult 0.1
 addUserKnob {7 focalDistanceCM +INVISIBLE}
 focalDistanceCM {{"focalDistance / unitMult" i}}
}
